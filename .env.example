# Copy to .env and fill in.
# AG Studio licence key (checked in the browser, so it ships in the client bundle).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# PayPal REST app credentials (server only, never exposed to the browser).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or production
PAYPAL_ENVIRONMENT=sandbox
# Optional, sandbox demo: a test business account that receives partner-offer payments.
PAYPAL_DEMO_MERCHANT_EMAIL=

# Log in with PayPal. Must match the Return URL in the PayPal app exactly.
# Defaults to <site>/api/auth/paypal/callback.
PAYPAL_LOGIN_REDIRECT_URI=
# Signs the login session cookie (32+ random characters).
SESSION_SECRET=

# Supabase (Project Settings > API). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# PayPal fee members pay on top of chama payments (percent and fixed USD).
# Defaults match the sandbox account's observed rate: 3.9% + $0.30.
PAYPAL_FEE_PERCENT=3.9
PAYPAL_FEE_FIXED=0.30

# Unitus staff who can view the platform wallet (comma-separated emails). Required in production.
UNITUS_OPERATOR_EMAILS=

# Protects the scheduler endpoint (/api/cron/tick). Any long random string.
CRON_SECRET=

# Set by scripts/register-webhook.mjs. Needed to verify PayPal webhooks.
PAYPAL_WEBHOOK_ID=
